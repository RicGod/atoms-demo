# 复制为 .env.local 后填写真实值；切勿提交密钥到 git
#
# 百炼 Key 读取优先级（服务端）：
#   1) 系统/用户环境变量 aliQwen-api（本地推荐；含连字符，勿写入本文件真实值）
#   2) 下方 BAILIAN_API_KEY（兼容 .env.local / Render）
# Render（及多数云平台）环境变量名通常不支持连字符，部署请用 BAILIAN_API_KEY，不要依赖 aliQwen-api。

# 阿里百炼兼容 API Key（三模型共用，仅服务端；本地也可不填，改用系统变量 aliQwen-api）
BAILIAN_API_KEY=

# Turso（libSQL）持久化；未配置时 API 降级为进程内内存存储
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 本地 API 端口（可选，默认 3001）；Render 会自动注入 PORT，无需也不应在平台上写死
API_PORT=3001
